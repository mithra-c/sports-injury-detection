# ============================================================================
# ENVIRONMENT VARIABLES - Secret Keys and Configuration
# ============================================================================
# IMPORTANT: Never share this file! Never push to GitHub!
# Rename this to .env and fill in your values
# ============================================================================

# Secret key for JWT tokens - Change this to something random in production!
# In real app, use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-12345678

# Database URL (when you connect to PostgreSQL)
# For now, we're using fake database in memory
# DATABASE_URL=postgresql://username:password@localhost:5432/sports_injury_db

# Environment type
ENVIRONMENT=development

# API configuration
API_PORT=8000
API_HOST=0.0.0.0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add http://localhost:3000 to Authorized JavaScript origins
# 3. Add http://localhost:3000 to Authorized redirect URIs
# 4. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Video storage (when implementing real upload)
# VIDEO_STORAGE_PATH=./uploads/videos
# MAX_VIDEO_SIZE_MB=500
